<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AlienFXControlCenter.Controls.KeyboardMatrix"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Click="SelectAll_Click" x:Uid="Matrix_SelectAll" />
            <Button Click="Clear_Click" x:Uid="Matrix_Clear" />
            <TextBlock
                x:Name="SelectionInfo"
                VerticalAlignment="Center"
                Opacity="0.7" />
        </StackPanel>

        <Border
            x:Name="KeyboardFrame"
            Padding="14"
            HorizontalAlignment="Left"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Canvas x:Name="CanvasHost" />
        </Border>

        <StackPanel
            x:Name="OtherSection"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock FontWeight="SemiBold" x:Uid="Matrix_OtherLights" />
            <VariableSizedWrapGrid
                x:Name="OtherHost"
                ItemHeight="42"
                ItemWidth="72"
                Orientation="Horizontal" />
        </StackPanel>
    </StackPanel>
</UserControl>
