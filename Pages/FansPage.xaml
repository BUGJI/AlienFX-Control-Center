<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AlienFXControlCenter.Pages.FansPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:AlienFXControlCenter.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AlienFXControlCenter.Models"
    xmlns:vm="using:AlienFXControlCenter.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Fans_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="Refresh_Click" x:Uid="Fans_Refresh" />
            <Button Click="Unlock_Click" x:Uid="Fans_Unlock" />
            <Button
                Click="Apply_Click"
                x:Uid="Fans_Apply"
                Style="{StaticResource AccentButtonStyle}" />
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Opacity="0.7"
                Text="{x:Bind ViewModel.HardwareSummary, Mode=OneWay}" />
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <Grid
            Grid.Row="2"
            ColumnSpacing="24"
            Visibility="{x:Bind ViewModel.HasHardware, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Fans}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FanItem">
                            <StackPanel Margin="0,0,0,18" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind DisplayName}" />
                                    <TextBlock Opacity="0.6" Text="{x:Bind RpmText, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Slider
                                        Width="280"
                                        Maximum="100"
                                        Minimum="0"
                                        Value="{x:Bind Boost, Mode=TwoWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Boost, Mode=OneWay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Opacity="0.5"
                                        Text="%" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" x:Uid="Fans_Temperatures" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SensorReading">
                                <TextBlock Margin="0,2" Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Spacing="6"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.HasHardware, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <FontIcon
                FontSize="32"
                Glyph="&#xE9CA;"
                Opacity="0.5" />
            <TextBlock
                HorizontalAlignment="Center"
                x:Uid="Fans_Empty_Title"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                HorizontalAlignment="Center"
                MaxWidth="380"
                x:Uid="Fans_Empty_Message"
                Opacity="0.7"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            Opacity="0.8"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Expander Grid.Row="4" x:Uid="Debug" Visibility="{x:Bind ViewModel.ShowDebug, Mode=OneWay}">
            <StackPanel Spacing="8">
                <TextBlock
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="240">
                    <TextBlock
                        FontFamily="Consolas"
                        FontSize="11"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.RawOutput, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Expander>
    </Grid>
</Page>
