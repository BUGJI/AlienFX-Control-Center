<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AlienFXControlCenter.Pages.KeysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AlienFXControlCenter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:AlienFXControlCenter.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:AlienFXControlCenter.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="Keys_Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                Click="Register_Click"
                Style="{StaticResource AccentButtonStyle}"
                x:Uid="Keys_Register" />
            <TextBox
                x:Name="SearchBox"
                Width="220"
                VerticalAlignment="Center"
                TextChanged="Search_TextChanged"
                x:Uid="Keys_Search" />
            <ComboBox
                x:Name="FilterBox"
                VerticalAlignment="Center"
                SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem x:Uid="Keys_FilterAll" />
                <ComboBoxItem x:Uid="Keys_FilterCustom" />
                <ComboBoxItem x:Uid="Keys_FilterBuiltIn" />
            </ComboBox>
            <Button Click="Reset_Click" x:Uid="Keys_ResetDefaults" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid RowSpacing="4" Visibility="{x:Bind ViewModel.HasKeys, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Padding="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="84" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontWeight="SemiBold" x:Uid="Keys_ColName" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" x:Uid="Keys_ColType" />
                    <TextBlock Grid.Column="2" FontWeight="SemiBold" x:Uid="Keys_ColSignature" />
                    <TextBlock Grid.Column="3" FontWeight="SemiBold" x:Uid="Keys_ColSource" />
                    <TextBlock Grid.Column="4" FontWeight="SemiBold" x:Uid="Keys_ColEnabled" />
                    <TextBlock Grid.Column="5" FontWeight="SemiBold" x:Uid="Keys_ColOps" />
                </Grid>

                <ListView
                    x:Name="KeyList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Keys}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyRow">
                            <Grid Padding="12,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <controls:KeyCap
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Badge="{x:Bind ActionText}"
                                    Dimmed="{x:Bind Dimmed, Mode=OneWay}"
                                    IsBound="{x:Bind Key.HasAction}"
                                    IsMissing="{x:Bind ActionMissing}"
                                    Label="{x:Bind Name}"
                                    ShowWarning="{x:Bind ShowTypingWarning}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"
                                    Text="{x:Bind TypeText}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"
                                    Text="{x:Bind SignatureText}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Opacity="0.8"
                                    Text="{x:Bind SourceText}" />

                                <CheckBox
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Checked="Enabled_Changed"
                                    IsChecked="{x:Bind Key.Enabled}"
                                    Tag="{x:Bind Key}"
                                    Unchecked="Enabled_Changed" />

                                <StackPanel
                                    Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Padding="6"
                                        Click="Rename_Click"
                                        Tag="{x:Bind Key}"
                                        x:Uid="Keys_Rename">
                                        <FontIcon FontSize="13" Glyph="&#xE8AC;" />
                                    </Button>
                                    <Button
                                        Padding="6"
                                        Click="Recapture_Click"
                                        Tag="{x:Bind Key}"
                                        x:Uid="Keys_Recapture">
                                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                                    </Button>
                                    <Button
                                        Padding="6"
                                        Click="Bind_Click"
                                        Tag="{x:Bind Key}"
                                        x:Uid="Keys_Bind">
                                        <FontIcon FontSize="13" Glyph="&#xE71B;" />
                                    </Button>
                                    <Button
                                        Padding="6"
                                        Click="Delete_Click"
                                        Tag="{x:Bind Key}"
                                        x:Uid="Keys_DeleteRow">
                                        <FontIcon FontSize="13" Glyph="&#xE74D;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <StackPanel
                HorizontalAlignment="Center"
                Spacing="6"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.HasKeys, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <FontIcon
                    FontSize="32"
                    Glyph="&#xE765;"
                    Opacity="0.5" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Uid="Keys_Empty_Title"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    MaxWidth="380"
                    x:Uid="Keys_Empty_Message"
                    Opacity="0.7"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Opacity="0.8"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            TextWrapping="Wrap" />

        <Expander
            Grid.Row="4"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            IsExpanded="False"
            x:Uid="Keys_Diagnostics">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch x:Name="RawToggle" x:Uid="Keys_RawToggle" Toggled="RawToggle_Toggled" />
                    <ToggleSwitch x:Name="HookToggle" x:Uid="Keys_HookToggle" Toggled="HookToggle_Toggled" />
                    <CheckBox x:Name="HideNormalBox" x:Uid="Keys_HideNormal" />
                    <CheckBox x:Name="PauseBox" x:Uid="Keys_Pause" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="TestHotkeyButton" Click="TestHotkey_Click" x:Uid="Keys_TestHotkey" />
                    <Button x:Uid="Keys_Copy" Click="Copy_Click" />
                    <Button x:Uid="Keys_Save" Click="Save_Click" />
                    <Button x:Uid="Keys_Clear" Click="Clear_Click" />
                    <Button x:Uid="Keys_Refresh" Click="Refresh_Click" />
                    <TextBlock
                        x:Name="DiagStatusText"
                        VerticalAlignment="Center"
                        Opacity="0.7" />
                </StackPanel>

                <TextBox
                    x:Name="LogBox"
                    MinHeight="160"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="12"
                    IsReadOnly="True"
                    IsSpellCheckEnabled="False"
                    TextWrapping="NoWrap"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Expander>
    </Grid>
</Page>
