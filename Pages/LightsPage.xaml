<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AlienFXControlCenter.Pages.LightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AlienFXControlCenter.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:AlienFXControlCenter.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <ScrollViewer
        x:Name="PageScroll"
        Padding="24,16,24,16"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <TextBlock x:Uid="Lights_Title" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox
                    x:Name="TargetBox"
                    Width="320"
                    x:Uid="Lights_Target"
                    DisplayMemberPath="Label"
                    SelectionChanged="TargetBox_SelectionChanged" />
                <Button
                    x:Name="RefreshButton"
                    VerticalAlignment="Bottom"
                    x:Uid="Lights_Refresh"
                    Click="Refresh_Click" />
                <Button
                    x:Name="ExportButton"
                    VerticalAlignment="Bottom"
                    x:Uid="Lights_ExportLayout"
                    Click="Export_Click" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <Grid x:Name="MainGrid" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock
                            VerticalAlignment="Center"
                            x:Uid="Lights_Scope"
                            Opacity="0.7" />
                        <RadioButton
                            x:Name="ScopeAll"
                            x:Uid="Lights_Scope_All"
                            Checked="Scope_Changed"
                            GroupName="Scope"
                            IsChecked="True" />
                        <RadioButton
                            x:Name="ScopeWasd"
                            x:Uid="Lights_Scope_Wasd"
                            Checked="Scope_Changed"
                            GroupName="Scope" />
                        <RadioButton
                            x:Name="ScopeArrows"
                            x:Uid="Lights_Scope_Arrows"
                            Checked="Scope_Changed"
                            GroupName="Scope" />
                        <RadioButton
                            x:Name="ScopeFKeys"
                            x:Uid="Lights_Scope_FKeys"
                            Checked="Scope_Changed"
                            GroupName="Scope" />
                    </StackPanel>

                    <controls:KeyboardMatrix
                        x:Name="Matrix"
                        SelectionChanged="Matrix_SelectionChanged"
                        Visibility="Collapsed" />

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="6"
                        Margin="0,48,0,0"
                        Visibility="{x:Bind ViewModel.HasDevices, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <FontIcon
                            FontSize="32"
                            Glyph="&#xE7BA;"
                            Opacity="0.5" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            x:Uid="Lights_Empty_Title"
                            Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            MaxWidth="380"
                            x:Uid="Lights_Empty_Message"
                            Opacity="0.7"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Border
                    x:Name="ColorCard"
                    Grid.Column="1"
                    Width="320"
                    Padding="16"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="Lights_Color" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ColorPicker
                            x:Name="Picker"
                            ColorChanged="Picker_ColorChanged"
                            HorizontalAlignment="Stretch"
                            IsAlphaEnabled="False"
                            IsColorChannelTextInputVisible="False"
                            IsColorSliderVisible="True"
                            IsHexInputVisible="True"
                            IsMoreButtonVisible="False"
                            MinWidth="0" />
                        <TextBlock x:Uid="Lights_Palette" Opacity="0.7" />
                        <VariableSizedWrapGrid
                            x:Name="Palette"
                            ItemHeight="38"
                            ItemWidth="38"
                            Orientation="Horizontal" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock
                x:Name="StatusText"
                Opacity="0.8"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap" />

            <Expander x:Uid="Debug" Visibility="{x:Bind ViewModel.ShowDebug, Mode=OneWay}">
                <TextBlock
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.LastCommand, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
